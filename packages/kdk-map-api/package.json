{
  "name": "@kalisio/kdk-map-api",
  "description": "The Kalisio Development Kit Map API Package",
  "version": "0.0.0",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  },
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "cross-env NODE_CONFIG_DIR=./test/config/ vitest run --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "git+https": "git://github.com/kalisio/kdk-ekosystem.git",
    "directory": "packages/kdk-map-api"
  },
  "bugs": {
    "url": "https://github.com/kalisio/kdk-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/kdk-ekosystem/tree/main/packages/kdk-map-api",
  "dependencies": {
    "@kalisio/kdk-core-api": "workspace:^",
    "@kalisio/kdk-map-common": "workspace:^",
    "@kalisio/kdk-core-common": "workspace:^",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@feathersjs/memory": "catalog:",
    "@turf/bbox": "catalog:",
    "@turf/intersect": "catalog:",
    "debug": "catalog:",
    "feathers-hooks-common": "catalog:",
    "feathers-mongodb-fuzzy-search": "catalog:",
    "fs-extra": "catalog:",
    "lodash": "catalog:",
    "moment": "catalog:",
    "sift": "catalog:",
    "minimatch": "^10.0.0",
    "superagent": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "nock": "catalog:",
    "standard": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@weacast/core": "catalog:",
    "is-docker": "catalog:"
  }
}