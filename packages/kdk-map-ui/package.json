{
  "name": "@kalisio/kdk-map-ui",
  "description": "Kalisio Development Kit Map UI Package",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "describe",
      "it",
      "test",
      "expect",
      "beforeAll",
      "afterAll",
      "beforeEach",
      "afterEach",
      "vi"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "kdk-map-ui"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "git+https": "git://github.com/kalisio/kdk-ekosystem.git",
    "directory": "packages/kdk-map-ui"
  },
  "bugs": {
    "url": "https://github.com/kalisio/kdk-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/kdk-ekosystem/tree/main/packages/kdk-map-ui",
  "dependencies": {
    "@kalisio/kdk-map-common": "workspace:^",
    "lodash-es": "catalog:"
  },
  "devDependencies": {},
  "peerDependencies": {
    "@kalisio/common-core": "catalog:",
    "@kalisio/common-graphics": "catalog:",
    "@kalisio/kdk-core-ui": "workspace:^",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}