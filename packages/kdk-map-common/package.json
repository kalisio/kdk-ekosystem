{
  "name": "@kalisio/kdk-map-common",
  "description": "The Kalisio Development Kit Map Common Package",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/kdk-ekosystem.git",
    "directory": "packages/kdk-map-common"
  },
  "bugs": {
    "url": "https://github.com/kalisio/kdk-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/kdk-ekosystem/tree/main/packages/kdk-map-common",
  "dependencies": {
    "@kalisio/kdk-core-common": "workspace:^",
    "@weacast/core": "catalog:",
    "geotiff": "catalog:",
    "jsdap": "catalog:",
    "lodash": "catalog:",
    "moment": "catalog:",
    "pmtiles": "catalog:",
    "typescript": "catalog:",
    "xml2js": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}