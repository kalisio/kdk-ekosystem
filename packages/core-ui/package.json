{
  "name": "@kalisio/core-ui",
  "description": "The Kalisio Development Kit Core UI Package",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "env": [
      "browser"
    ],
    "globals": [
      "describe",
      "it",
      "expect",
      "beforeAll",
      "afterAll",
      "beforeEach",
      "afterEach",
      "vi"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/kdk-ekosystem.git",
    "directory": "packages/core-ui"
  },
  "bugs": {
    "url": "https://github.com/kalisio/kdk-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/kdk-ekosystem/tree/main/packages/core-ui",
  "dependencies": {
    "@feathersjs/client": "catalog:",
    "@kalisio/core-common": "workspace:^",
    "@kalisio/feathers-automerge": "catalog:",
    "@kalisio/feathers-localforage": "catalog:",
    "@kalisio/feathers-s3": "catalog:",
    "@thumbmarkjs/thumbmarkjs": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "ajv-i18n": "catalog:",
    "ajv-keywords": "catalog:",
    "chart.js": "catalog:",
    "chartjs-adapter-moment": "catalog:",
    "chartjs-chart-matrix": "catalog:",
    "chartjs-plugin-annotation": "catalog:",
    "chartjs-plugin-datalabels": "catalog:",
    "chartjs-plugin-zoom": "catalog:",
    "chroma-js": "catalog:",
    "debug": "catalog:",
    "email-validator": "catalog:",
    "feathers-reactive": "catalog:",
    "jwt-decode": "catalog:",
    "localforage": "catalog:",
    "lodash": "catalog:",
    "loglevel": "catalog:",
    "mathjs": "catalog:",
    "moment": "catalog:",
    "moment-timezone": "catalog:",
    "papaparse": "catalog:",
    "path-browserify": "catalog:",
    "quasar": "catalog:",
