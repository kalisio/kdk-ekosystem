{
  "name": "@kalisio/kdk-core-ui",
  "description": "Kalisio Development Kit Core UI Package",
  "version": "0.2.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "env": [
      "browser"
    ],
    "globals": [
      "caches",
      "describe",
      "it",
      "test",
      "expect",
      "beforeAll",
      "afterAll",
      "beforeEach",
      "afterEach",
      "vi"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "git+https": "git://github.com/kalisio/kdk-ekosystem.git",
    "directory": "packages/kdk-core-ui"
  },
  "bugs": {
    "url": "https://github.com/kalisio/kdk-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/kdk-ekosystem/tree/main/packages/kdk-core-ui",
  "dependencies": {
    "@feathersjs/client": "catalog:",
    "@kalisio/feathers-automerge": "catalog:",
    "@kalisio/feathers-s3": "catalog:",
    "@kalisio/kdk-core-common": "workspace:^",
    "lodash-es": "catalog:"
  },
  "devDependencies": {
  },
  "peerDependencies": {
    "@kalisio/common-core": "catalog:",
    "@kalisio/common-graphics": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}