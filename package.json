{
  "name": "kdk-ekosystem",
  "description": "The Kalisio Development Kit Packages Ecosystem",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:kdk-core-api": "pnpm --filter @kalisio/kdk-core-api build",
    "build:kdk-core-common": "pnpm --filter @kalisio/kdk-core-common build",
    "build:kdk-core-ui": "pnpm --filter @kalisio/kdk-core-ui build",
    "build:kdk-map-api": "pnpm --filter @kalisio/kdk-map-api build",
    "build:kdk-map-common": "pnpm --filter @kalisio/kdk-map-common build",
    "build:kdk-map-ui": "pnpm --filter @kalisio/kdk-map-ui build",
    "bump": "changeset version",
    "clear": "pnpm -r exec rimraf node_modules dist coverage",
    "docs:build": "pnpm --filter docs run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:prepare": "pnpm --filter './examples/*' build",
    "inspect": "pnpm knip",
    "lint": "pnpm -r lint",
    "lint:kdk-core-api": "pnpm --filter @kalisio/kdk-core-api lint",
    "lint:kdk-core-common": "pnpm --filter @kalisio/kdk-core-common lint",
    "lint:kdk-core-ui": "pnpm --filter @kalisio/kdk-core-ui lint",
    "lint:kdk-map-api": "pnpm --filter @kalisio/kdk-map-api lint",
    "lint:kdk-map-common": "pnpm --filter @kalisio/kdk-map-common lint",
    "lint:kdk-map-ui": "pnpm --filter @kalisio/kdk-map-ui lint",
    "postrelease": "git push --follow-tags",
    "posttest": "pnpm lcov-result-merger --prepend-source-files 'packages/*/coverage/lcov.info' coverage/lcov.info",
    "prebump": "changeset",
    "prepare": "node scripts/prepare.mjs",
    "prerelease": "pnpm build",
    "pretest": "mkdir -p coverage",
    "release": "changeset publish",
    "test": "pnpm -r test",
    "test:kdk-core-api": "pnpm --filter @kalisio/kdk-core-api test",
    "test:kdk-core-common": "pnpm --filter @kalisio/kdk-core-common test",
    "test:kdk-core-ui": "pnpm --filter @kalisio/kdk-core-ui test",
    "test:kdk-map-api": "pnpm --filter @kalisio/kdk-map-api test",
    "test:kdk-map-common": "pnpm --filter @kalisio/kdk-map-common test",
    "test:kdk-map-ui": "pnpm --filter @kalisio/kdk-map-ui test"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "git+https": "git://github.com/kalisio/kdk-ekosystem.git"
  },
  "bugs": {
